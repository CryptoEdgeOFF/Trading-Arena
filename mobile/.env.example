# Développement mobile : base Neon isolée, sans impact sur les compétitions live.
VITE_API_URL=https://btf-mobile-staging-production.up.railway.app

# Active uniquement le raccourci ARTEMTEST987 sur le staging si
# ALLOW_TEST_LOGIN=true est aussi défini sur le service Railway staging.
VITE_ENABLE_TEST_LOGIN=false
VITE_APNS_ENV=auto

# Pour les builds App Store / Play Store, VITE_API_URL doit être remplacée
# par l'URL du même backend de production que le site PC.
